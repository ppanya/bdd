{
  "name": "bdd",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bunx wdio run wdio.conf.ts",
    "test:web": "bunx wdio run wdio.conf.ts --suite web",
    "test:api": "bunx wdio run wdio.conf.ts --suite api",
    "android": "bash scripts/start-android-all.sh",
    "ios": "bash scripts/start-ios-all.sh",
    "emulator:interactive": "bash scripts/talkback.sh off",
    "emulator:test-mode": "bash scripts/talkback.sh on",
    "test:mobile:android": "bash scripts/run-mobile-tests.sh android",
    "test:mobile:ios": "bash scripts/run-mobile-tests.sh ios",
    "mock": "bunx @stoplight/prism-cli mock openapi.yaml --port 4010 --host 0.0.0.0",
    "mock:test": "bunx run mock & sleep 3 && bunx run test:api; kill %1",
    "setup": "bash scripts/setup.sh",
    "setup:android": "bash scripts/setup.sh --android",
    "setup:ios": "bash scripts/setup.sh --ios",
    "generate:bru": "bun scripts/generate-bru.ts",
    "pretest": "rm -rf allure-results",
    "pretest:mobile:android": "rm -rf allure-results",
    "pretest:mobile:ios": "rm -rf allure-results",
    "report:generate": "bunx allure generate allure-results --config allurerc.mjs",
    "report:allure": "bunx allure open allure-report --port 4040",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check ."
  },
  "dependencies": {
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/cucumber-framework": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mcp": "^2.3.0",
    "@wdio/reporter": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^7.0.0",
    "appium-xcuitest-driver": "^10.0.0",
    "expect-webdriverio": "^5.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-gherkin": "^3.1.3",
    "ts-node": "^10.9.2",
    "wdio-video-reporter": "^6.2.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "appium"
  ]
}
