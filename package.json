    "@types/bun": "latest",
    "playwright-bdd": "^8.4.2",
    "prettier": "^3.8.1",
    "prettier-plugin-gherkin": "^3.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
