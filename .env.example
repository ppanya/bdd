# Base URL ของ web app (ใช้ใน UI tests)
# browser.url('/login') จะไปที่ BASE_URL/login
# demo: https://the-internet.herokuapp.com
BASE_URL=https://the-internet.herokuapp.com

# Base URL ของ API
# - ถ้า API ยังไม่พร้อม: รัน `bun run mock` แล้วใช้ URL นี้ (Prism)
# - ถ้า API พร้อมแล้ว: เปลี่ยนเป็น URL จริง เช่น http://localhost:3000
API_BASE_URL=http://localhost:4010

# Mobile testing (Appium)
# MOBILE_PLATFORM: android | ios
MOBILE_PLATFORM=android

# Path ไปยัง Flutter app binary (อยู่ใน apps/ ซึ่ง gitignored)
ANDROID_APP_PATH=apps/app-debug.apk
IOS_APP_PATH=apps/Runner.app

# Living Checklist: tag สำหรับ run นี้ (version, release name, หรือ branch)
# ถ้าไม่ระบุ จะใช้ git branch name หรือ "untagged"
# ตัวอย่าง: RELEASE_TAG=v1.2.0 bun run test
RELEASE_TAG=
