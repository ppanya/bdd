# ─────────────────────────────────────────────────────────────────────────────
# Web Testing
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the web app under test.
# browser.url('/login') resolves to BASE_URL/login.
# Used by: wdio.conf.ts → baseUrl
BASE_URL=https://the-internet.herokuapp.com

# ─────────────────────────────────────────────────────────────────────────────
# API Testing
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for API tests.
# Use http://localhost:4010 with `bun run mock` (Prism mock server).
# Switch to a real server URL when testing against a live backend.
# Used by: steps/api/*.steps.ts → BaseAPI
API_BASE_URL=http://localhost:4010

# ─────────────────────────────────────────────────────────────────────────────
# Mobile Testing — General
# ─────────────────────────────────────────────────────────────────────────────

# Target mobile platform. Drives capability selection in wdio.conf.ts.
# Also disables video reporter (prevents Appium "socket hang up").
# Values: android | ios
# Used by: wdio.conf.ts, fixtures/index.ts, scripts/run-mobile-tests.sh
MOBILE_PLATFORM=android

# Path to the Flutter Android APK binary (relative to project root).
# File lives in apps/ which is gitignored — obtain from the dev team.
# Used by: wdio.conf.ts → appium:app capability
ANDROID_APP_PATH=apps/app-mock-release.apk

# Path to the Flutter iOS app (.ipa or .app bundle, relative to project root).
# Supports both formats: .ipa is auto-extracted to .app for simulator use.
# File lives in apps/ which is gitignored — obtain from the dev team.
# Used by: wdio.conf.ts → appium:app capability, scripts/start-ios-all.sh
IOS_APP_PATH=apps/Runner.ipa

# Mock PIN used by ensureAuthenticated() to log in during mobile test setup.
# Must match the PIN configured in the mock app.
# Default: 123456
# Used by: support/mobile/session-helper.ts
TEST_PIN=123456

# ─────────────────────────────────────────────────────────────────────────────
# Mobile Testing — Android
# ─────────────────────────────────────────────────────────────────────────────

# Path to the Android SDK root.
# Default: ~/Library/Android/sdk (macOS standard location).
# Used by: scripts/lib/defaults.sh, wdio.conf.ts
ANDROID_HOME=

# Name of the Android Virtual Device (AVD) to boot.
# Run `emulator -list-avds` to see available AVDs.
# Default: Pixel_7_API_34_arm64
# Used by: scripts/lib/common.sh, wdio.conf.ts → appium:avd
ANDROID_AVD=

# Android package name of the app under test.
# Auto-extracted from the APK by `bun run android`.
# Set manually if not using the start script (e.g. CI environments).
# Default: com.bbt.bitkubnext.mock
# Used by: wdio.conf.ts → appium:appPackage, fixtures/mobile.hooks.ts
APP_PACKAGE=

# When true, skips APK reinstall and app launch — assumes the app is
# already running on the emulator (pre-warmed by start-android-all.sh).
# Set automatically by scripts/run-mobile-tests.sh.
# Set to false to force a full reinstall on the next test run.
# Default: true (set by script)
# Used by: wdio.conf.ts
APP_READY=

# ─────────────────────────────────────────────────────────────────────────────
# Mobile Testing — iOS
# ─────────────────────────────────────────────────────────────────────────────

# Name of the iOS Simulator to target.
# Run `xcrun simctl list devices` to see available simulators.
# Default: iPhone 15
# Used by: wdio.conf.ts → appium:deviceName
IOS_DEVICE_NAME=

# iOS platform version matching the simulator above.
# Default: 17.0
# Used by: wdio.conf.ts → appium:platformVersion
IOS_PLATFORM_VER=

# Bundle ID of the iOS app under test.
# Default: com.bbt.bitkubnext.mock
# Used by: fixtures/mobile.hooks.ts → terminate/activate app
IOS_BUNDLE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Appium
# ─────────────────────────────────────────────────────────────────────────────

# Port that the Appium server listens on.
# Change if port 4723 is in use by another process.
# Default: 4723
# Used by: wdio.conf.ts, scripts/run-mobile-tests.sh
APPIUM_PORT=4723

# ─────────────────────────────────────────────────────────────────────────────
# Test Filtering (runtime overrides — not usually committed)
# ─────────────────────────────────────────────────────────────────────────────

# Cucumber tag expression to filter which scenarios run.
# Example: TAGS='@smoke' bun run test:mobile:android
# Example: TAGS='@smoke and not @wip' bun run test
# Used by: wdio.conf.ts → cucumberOpts.tagExpression
TAGS=

# Filter scenarios by name (substring match, case-sensitive).
# Example: SCENARIO_NAME="ปุ่ม Log in ถูก enable" bun run test
# Used by: wdio.conf.ts → cucumberOpts.name
SCENARIO_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Reporting
# ─────────────────────────────────────────────────────────────────────────────

# Tag identifying this test run in the Living Checklist report.
# Use a version number, release name, or branch name.
# Falls back to git branch name, then "untagged" if not set.
# Example: RELEASE_TAG=v1.2.0
# Used by: scripts/checklist / report:checklist
RELEASE_TAG=

# Monday.com workspace base URL for linking @monday=BOARD/ITEM tags in Allure.
# Example: MONDAY_BASE_URL=https://myworkspace.monday.com
# Used by: fixtures/index.ts → allureReporter.addLink
MONDAY_BASE_URL=https://bitkub-chain.monday.com

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

# Winston log level for framework internals.
# Values: error | warn | info | debug
# Default: info
# Used by: support/logger.ts
LOG_LEVEL=info
