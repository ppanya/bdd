# Base URL ของ web app (ใช้ใน UI tests)
# page.goto('/login') จะไปที่ BASE_URL/login
# demo: https://the-internet.herokuapp.com
BASE_URL=https://the-internet.herokuapp.com

# Base URL ของ API
# - ถ้า API ยังไม่พร้อม: รัน `bun run mock` แล้วใช้ URL นี้ (Prism)
# - ถ้า API พร้อมแล้ว: เปลี่ยนเป็น URL จริง เช่น http://localhost:3000
API_BASE_URL=http://localhost:4010
