# Base URL ของ web app (ใช้ใน UI tests)
# browser.url('/login') จะไปที่ BASE_URL/login
# demo: https://the-internet.herokuapp.com
BASE_URL=https://the-internet.herokuapp.com

# Base URL ของ API
# - ถ้า API ยังไม่พร้อม: รัน `bun run mock` แล้วใช้ URL นี้ (Prism)
# - ถ้า API พร้อมแล้ว: เปลี่ยนเป็น URL จริง เช่น http://localhost:3000
API_BASE_URL=http://localhost:4010

# Mobile testing (Appium)
# MOBILE_PLATFORM: android | ios
MOBILE_PLATFORM=android

# Path ไปยัง Flutter app binary (อยู่ใน apps/ ซึ่ง gitignored)
ANDROID_APP_PATH=apps/app-mock-release.apk
IOS_APP_PATH=apps/Runner.app

# Android emulator (inspect:android / test:mobile:android)
# ANDROID_HOME: path ไปยัง Android SDK (default: ~/Library/Android/sdk)
# ANDROID_AVD:  ชื่อ AVD ที่จะเปิด (default: Pixel_7_API_34_arm64)
ANDROID_HOME=
ANDROID_AVD=

# iOS simulator (inspect:ios / test:mobile:ios)
# IOS_DEVICE_NAME:  ชื่อ Simulator (default: iPhone 15)
# IOS_PLATFORM_VER: iOS version (default: 17.0)
IOS_DEVICE_NAME=
IOS_PLATFORM_VER=

# Appium server port (ใช้กับ inspect:android และ inspect:ios)
APPIUM_PORT=4723

# Package name ของ Android app (auto-extracted จาก APK โดย bun run android)
# ถ้าไม่ได้ใช้ bun run android ให้ set ค่านี้เองเพื่อให้ wdio.conf.ts ใช้ terminate/activate app
# Default: com.bbt.bitkubnext.mock
APP_PACKAGE=

# Living Checklist: tag สำหรับ run นี้ (version, release name, หรือ branch)
# ถ้าไม่ระบุ จะใช้ git branch name หรือ "untagged"
# ตัวอย่าง: RELEASE_TAG=v1.2.0 bun run test
RELEASE_TAG=

# Monday.com integration — links @monday=BOARD/ITEM tags to Allure reports
# ตัวอย่าง: MONDAY_BASE_URL=https://myworkspace.monday.com
MONDAY_BASE_URL=
