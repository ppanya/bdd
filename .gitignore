# dependencies
node_modules

# dotenv — copy from .env.example, never commit real credentials
.env
.env.*.local

# Playwright legacy — auto-generated, do not commit
.features-gen/
test-results/
playwright-report/

# WDIO / Allure output
allure-results/
allure-report/

# Living Checklist reports (generated at runtime)
reports/

# Flutter app binaries (too large for git)
apps/

# Flutter build outputs (source in flutter_app/ is tracked)
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/pubspec.lock

# Build / output
out
dist
*.tgz
*.tsbuildinfo

# Logs
*.log

# Editor
.idea
.vscode

# macOS
.DS_Store
